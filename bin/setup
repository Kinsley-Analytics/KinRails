#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# bin/setup
# ──────────────────────────────────────────────────────────────────────────────
#
# Sets up the application for development after cloning the template.
#
# Usage:
#   bin/setup
#
# Prerequisites:
#   - Ruby 3.4.x
#   - PostgreSQL running locally
#   - Node.js + Yarn (for esbuild JS bundling)
#
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  Setting up for development..."
echo "══════════════════════════════════════════════════════════════"
echo ""

# ─── Ruby dependencies ───────────────────────────────────────────────────────
echo "→ Installing Ruby dependencies..."
bundle check &>/dev/null || bundle install
echo ""

# ─── JavaScript dependencies ─────────────────────────────────────────────────
echo "→ Installing JavaScript dependencies..."
if command -v yarn &>/dev/null; then
  yarn install
else
  echo "  ⚠ yarn not found. Install it with: npm install -g yarn"
  echo "    esbuild requires Node.js for JS bundling."
fi
echo ""

# ─── Environment files ───────────────────────────────────────────────────────
echo "→ Checking environment files..."

if [[ ! -f .env.development ]]; then
  if [[ -f .env.development.example ]]; then
    cp .env.development.example .env.development
    echo "  Created .env.development from example. Edit it with your local settings."
  fi
else
  echo "  .env.development already exists."
fi

if [[ ! -f .env.test ]]; then
  if [[ -f .env.test.example ]]; then
    cp .env.test.example .env.test
    echo "  Created .env.test from example."
  fi
else
  echo "  .env.test already exists."
fi
echo ""

# ─── Database ────────────────────────────────────────────────────────────────
echo "→ Setting up database..."
bin/rails db:prepare
echo ""

# ─── Clean up ────────────────────────────────────────────────────────────────
echo "→ Clearing old logs and temp files..."
bin/rails log:clear tmp:clear
echo ""

# ─── Verify ──────────────────────────────────────────────────────────────────
echo "→ Running sanity check..."
if bin/rails runner "puts 'Rails loaded successfully'" &>/dev/null; then
  echo "  ✓ Rails boots correctly."
else
  echo "  ✗ Rails failed to boot. Check the error above."
  exit 1
fi
echo ""

# ─── Done ────────────────────────────────────────────────────────────────────
echo "══════════════════════════════════════════════════════════════"
echo "  Setup complete!"
echo "══════════════════════════════════════════════════════════════"
echo ""
echo "  Start the app:    bin/dev"
echo "  Run tests:        bin/rails test"
echo "  Rails console:    bin/rails console"
echo ""